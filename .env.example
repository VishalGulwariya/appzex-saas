# Required API runtime configuration. Production WEB_ORIGIN must be explicit HTTPS.
NODE_ENV=development
DATABASE_URL=mysql://user:replace_with_local_password@127.0.0.1:3306/appzex
SESSION_SECRET=replace_with_at_least_32_random_characters
WEB_ORIGIN=http://localhost:3000

# Optional API runtime configuration
API_PORT=4000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=7
FILE_STORAGE_PATH=./private-uploads
AUTH_LOGIN_RATE_LIMIT=10
AI_REPORT_RATE_LIMIT=5

# Optional AI reports; leave AI_PROVIDER empty to disable
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000

# Next.js process environment, supplied before config evaluation in production.
# Not a browser-facing URL; root .env alone is not loaded by next.config.ts.
API_INTERNAL_URL=http://localhost:4000

# Seed script only; never required by API runtime.
# Optional. Defaults to the documented local evaluation password "password123".
SEED_PASSWORD=password123
