# AppZex web app (`apps/web`) environment configuration.
#
# This app needs exactly ONE variable. It is read on the server at build time by
# `apps/web/next.config.ts` and is never sent to the browser.
#
# No `NEXT_PUBLIC_*` variable is required or supported: every browser request goes to a
# same-origin relative path such as `/api/v1/auth/login`, and Next.js proxies it to this
# origin. Prefixing this URL with `NEXT_PUBLIC_` would be both unnecessary and a way to
# leak an internal hostname into the client bundle.

# Build-time only. The /api/v1 rewrite target, as an origin with no trailing path.
# In production this must be an absolute, non-loopback HTTP(S) origin, for example
# https://api.your-domain.com. It is resolved while the bundle is built, so changing it
# later requires a rebuild; setting it only at runtime will NOT take effect.
#
# The production build fails fast if this is missing or loopback. For a local compile you
# can omit it: `npm run build:web` then substitutes the reserved, unresolvable placeholder
# https://api.internal.invalid.
API_INTERNAL_URL=https://api.internal.invalid

# Deliberately absent from this file:
#   DATABASE_URL, SESSION_SECRET, AI_API_KEY - API runtime secrets that must never reach
#   the web tier or the browser bundle. Set them only on the API service.